    "Tap + to link a node with the code your Node64 shows under \"ipv64 link\", or connect to one directly." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf +, um einen Node mit dem Code zu verknüpfen, den dein Node64 unter „ipv64 link“ anzeigt, oder verbinde dich direkt mit einem."
          }
        }
      }
    },
    "Target" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziel"
          }
        }
      }
    },
    "Target host" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zielhost"
          }
        }
      }
    },
    "Target port" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zielport"
          }
        }
      }
    },
    "Terminate on the servers" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf den Servern beenden"
          }
        }
      }
    },
    "Test connection" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbindung testen"
          }
        }
      }
    },
    "Test not sent" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Test nicht gesendet"
          }
        }
      }
    },
    "Test queued" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Test eingereiht"
          }
        }
      }
    },
    "Test sent" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Test gesendet"
          }
        }
      }
    },
    "The API key contains invalid characters." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der API-Key enthält ungültige Zeichen."
          }
        }
      }
    },
    "The API key is sent unencrypted over the internet. Use https:// or a VPN if you can." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der API-Key wird unverschlüsselt über das Internet gesendet. Verwende nach Möglichkeit https:// oder ein VPN."
          }
        }
      }
    },
    "The App for the Free DynDNS2 Service from Dennis Schröder" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App für den kostenlosen DynDNS2-Service von Dennis Schröder"
          }
        }
      }
    },
    "The DynDNS IP check no longer counts CDN and failover records, so CDN domains no longer show a different IP." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die DynDNS-IP-Prüfung zählt keine CDN- und Failover-Einträge mehr, CDN-Domains zeigen also keine abweichende IP mehr an."
          }
        }
      }
    },
    "The access token of \"%@\" is revoked. The node keeps running standalone but no longer syncs with ipv64.net. This cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zugriffstoken von „%@“ wird widerrufen. Der Node läuft eigenständig weiter, synchronisiert sich aber nicht mehr mit ipv64.net. Das kann nicht rückgängig gemacht werden."
          }
        }
      }
    },
    "The address and API key are removed from this device. The node itself is not changed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adresse und API-Key werden von diesem Gerät entfernt. Der Node selbst bleibt unverändert."
          }
        }
      }
    },
    "The address and API key of \"%@\" are removed from this device. The node itself is not changed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adresse und API-Key von „%@“ werden von diesem Gerät entfernt. Der Node selbst bleibt unverändert."
          }
        }
      }
    },
    "The address answered, but not like a Node64 API. Check the URL (it usually ends in /api)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Adresse hat geantwortet, aber nicht wie eine Node64-API. Prüfe die URL (sie endet meist auf /api)."
          }
        }
      }
    },
    "The app is now also available in German." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App gibt es jetzt auch auf Deutsch."
          }
        }
      }
    },
    "The app selected the first available user in the list." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App hat den ersten verfügbaren Benutzer in der Liste ausgewählt."
          }
        }
      }
    },
    "The checks of this node are not continued and will be deleted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Checks dieses Nodes werden nicht fortgeführt und gelöscht."
          }
        }
      }
    },
    "The code was not accepted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Code wurde nicht akzeptiert."
          }
        }
      }
    },
    "The host can no longer be queried through this access." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Host kann über diesen Zugang nicht mehr abgefragt werden."
          }
        }
      }
    },
    "The key is sent unencrypted on your local network." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Key wird unverschlüsselt in deinem lokalen Netzwerk gesendet."
          }
        }
      }
    },
    "The name can have at most 100 characters." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Name darf höchstens 100 Zeichen lang sein."
          }
        }
      }
    },
    "The network connection appears to be offline. \nPlease check your connection." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Netzwerkverbindung scheint offline zu sein. \nBitte prüfe deine Verbindung."
          }
        }
      }
    },
    "The node answered with HTTP %lld." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Node hat mit HTTP %lld geantwortet."
          }
        }
      }
    },
    "The node at this address reports the ID %@ instead of %@. The connection was saved anyway — check the address if this is unexpected." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Node unter dieser Adresse meldet die ID %1$@ statt %2$@. Die Verbindung wurde trotzdem gespeichert – prüfe die Adresse, falls das unerwartet ist."
          }
        }
      }
    },
    "The node did not report its ID. Update Node64 and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Node hat seine ID nicht gemeldet. Aktualisiere Node64 und versuche es erneut."
          }
        }
      }
    },
    "The node fetches its token itself. This usually takes less than a minute." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Node holt sich seinen Token selbst. Das dauert meist weniger als eine Minute."
          }
        }
      }
    },
    "The node has not fetched its token yet. Make sure it is online and has internet access, then pull down to refresh." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Node hat seinen Token noch nicht abgeholt. Stelle sicher, dass er online ist und Internetzugang hat, und ziehe dann zum Aktualisieren nach unten."
          }
        }
      }
    },
    "The node has not reported back yet. It runs the command as soon as it syncs. Open the command history later to see the result." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Node hat sich noch nicht zurückgemeldet. Er führt den Befehl aus, sobald er synchronisiert. Öffne später den Befehlsverlauf, um das Ergebnis zu sehen."
          }
        }
      }
    },
    "The node is offline. Commands are picked up when it reconnects." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Node ist offline. Befehle werden abgeholt, sobald er sich wieder verbindet."
          }
        }
      }
    },
    "The node keeps running standalone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Node läuft eigenständig weiter."
          }
        }
      }
    },
    "The node rejected the API key (HTTP %lld)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Node hat den API-Key abgelehnt (HTTP %lld)."
          }
        }
      }
    },
    "The node reported an error." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Node hat einen Fehler gemeldet."
          }
        }
      }
    },
    "The node returned no data for this host." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Node hat keine Daten für diesen Host geliefert."
          }
        }
      }
    },
    "The node's HTTPS certificate is not trusted by this device. Use the node's local http:// address or a valid certificate." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das HTTPS-Zertifikat des Nodes wird von diesem Gerät nicht als vertrauenswürdig eingestuft. Verwende die lokale http://-Adresse des Nodes oder ein gültiges Zertifikat."
          }
        }
      }
    },
    "The port must be between 1 and 65535." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Port muss zwischen 1 und 65535 liegen."
          }
        }
      }
    },
    "The selected channel no longer exists." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der ausgewählte Kanal existiert nicht mehr."
          }
        }
      }
    },
    "The server describes app channels in a format this app version does not know. Please update the app or add this device at ipv64.net." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server beschreibt App-Kanäle in einem Format, das diese App-Version nicht kennt. Bitte aktualisiere die App oder füge dieses Gerät auf ipv64.net hinzu."
          }
        }
      }
    },
    "The server did not return the key. Delete it and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat den Key nicht zurückgegeben. Lösche ihn und versuche es erneut."
          }
        }
      }
    },
    "The server did not send the test notification." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat die Testbenachrichtigung nicht gesendet."
          }
        }
      }
    },
    "The server did not send the test notification. Please check the channel settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat die Testbenachrichtigung nicht gesendet. Bitte prüfe die Kanaleinstellungen."
          }
        }
      }
    },
    "The server did not unlink the node. Please try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat die Verknüpfung des Nodes nicht aufgehoben. Bitte versuche es erneut."
          }
        }
      }
    },
    "The server requires the setting \"%@\" for app channels. Please add this device at ipv64.net." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server verlangt für App-Kanäle die Einstellung „%@“. Bitte füge dieses Gerät auf ipv64.net hinzu."
          }
        }
      }
    },
    "The server returned no results per IP." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat keine Ergebnisse pro IP zurückgegeben."
          }
        }
      }
    },
    "The servers decrypt (own certificate) and filter there: blocklists, limits, HTTP/3. Good for small uploads. Not with TLS passthrough." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Server entschlüsseln (eigenes Zertifikat) und filtern dort: Blocklisten, Limits, HTTP/3. Gut für kleine Uploads. Nicht mit TLS-Passthrough."
          }
        }
      }
    },
    "The servers go directly to your target without a tunnel — it must be reachable from the internet. Set up on the website:" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Server greifen ohne Tunnel direkt auf dein Ziel zu – es muss aus dem Internet erreichbar sein. Einrichtung auf der Website:"
          }
        }
      }
    },
    "The servers only pass the encrypted connection through; it is decrypted in your node. The right choice for almost everything." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Server leiten die verschlüsselte Verbindung nur durch; sie wird in deinem Node entschlüsselt. Die richtige Wahl für fast alles."
          }
        }
      }
    },
    "The settings of this channel type can only be changed at ipv64.net." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Einstellungen dieses Kanaltyps können nur auf ipv64.net geändert werden."
          }
        }
      }
    },
    "The test notification was queued at the node." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Testbenachrichtigung wurde beim Node eingereiht."
          }
        }
      }
    },
    "The test notification was sent." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Testbenachrichtigung wurde gesendet."
          }
        }
      }
    },
    "The test run did not finish within 60 seconds. Check the healthcheck details later to see whether the change was applied." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Testlauf wurde nicht innerhalb von 60 Sekunden beendet. Prüfe später die Healthcheck-Details, ob die Änderung übernommen wurde."
          }
        }
      }
    },
    "The test run expired before it finished." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Testlauf ist abgelaufen, bevor er beendet wurde."
          }
        }
      }
    },
    "The test run failed, so the check keeps its previous settings. Other changes were saved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Testlauf ist fehlgeschlagen, daher behält der Check seine bisherigen Einstellungen. Andere Änderungen wurden gespeichert."
          }
        }
      }
    },
    "The test run failed. The change was not applied." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Testlauf ist fehlgeschlagen. Die Änderung wurde nicht übernommen."
          }
        }
      }
    },
    "The update token was rotated. The old update URL no longer works. Enter the new URL in your router or update script." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Update-Token wurde erneuert. Die alte Update-URL funktioniert nicht mehr. Trage die neue URL in deinem Router oder Update-Skript ein."
          }
        }
      }
    },
    "This API key does not belong to an active account." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser API-Key gehört zu keinem aktiven Account."
          }
        }
      }
    },
    "This address belongs to another node (%@). Forget the direct connection and connect again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Adresse gehört zu einem anderen Node (%@). Entferne die Direktverbindung und verbinde dich erneut."
          }
        }
      }
    },
    "This app" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese App"
          }
        }
      }
    },
    "This app uses the API key \"%@\"." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese App verwendet den API-Key „%@“."
          }
        }
      }
    },
    "This app uses this key and cannot delete it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese App verwendet diesen Key und kann ihn nicht löschen."
          }
        }
      }
    },
    "This app uses your account key." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese App verwendet deinen Account-Key."
          }
        }
      }
    },
    "This app was created with the help of the Raspberry Pi Cloud community. All rights reserved by Dennis Schröder." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese App wurde mit Hilfe der Raspberry-Pi-Cloud-Community erstellt. Alle Rechte vorbehalten von Dennis Schröder."
          }
        }
      }
    },
    "This app's key type is unknown." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Key-Typ dieser App ist unbekannt."
          }
        }
      }
    },
    "This change replaces the record: it gets a new ID and record token. Scripts that use the old record token must be updated." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Änderung ersetzt den Eintrag: Er erhält eine neue ID und einen neuen Eintrags-Token. Skripte, die den alten Eintrags-Token verwenden, müssen angepasst werden."
          }
        }
      }
    },
    "This channel won't receive notifications and can't be tested until it is verified." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Kanal erhält keine Benachrichtigungen und kann nicht getestet werden, bis er bestätigt ist."
          }
        }
      }
    },
    "This creates your personal token if you do not have one yet. Keep it secret: anyone with the token can fetch your live blocklist." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch wird dein persönlicher Token erstellt, falls du noch keinen hast. Halte ihn geheim: Jeder mit dem Token kann deine Live-Blockliste abrufen."
          }
        }
      }
    },
    "This device" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät"
          }
        }
      }
    },
    "This device could not be registered for push notifications (Apple Push Notification service or the push service is not reachable). Please check your internet connection and try again later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät konnte nicht für Push-Benachrichtigungen registriert werden (Apple Push Notification Service oder der Push-Dienst ist nicht erreichbar). Bitte prüfe deine Internetverbindung und versuche es später erneut."
          }
        }
      }
    },
    "This device's push channel can't be deleted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Push-Kanal dieses Geräts kann nicht gelöscht werden."
          }
        }
      }
    },
    "This feature is not available on your plan." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Funktion ist in deinem Tarif nicht verfügbar."
          }
        }
      }
    },
    "This is an example widget." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies ist ein Beispiel-Widget."
          }
        }
      }
    },
    "This is not a valid public IP address." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist keine gültige öffentliche IP-Adresse."
          }
        }
      }
    },
    "This key is used by this app and cannot be deleted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Key wird von dieser App verwendet und kann nicht gelöscht werden."
          }
        }
      }
    },
    "This password was not seen in the Honeypot64 data. That does not mean it is safe: use long, unique passwords and a password manager." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Passwort tauchte in den Honeypot64-Daten nicht auf. Das heißt nicht, dass es sicher ist: Verwende lange, einmalige Passwörter und einen Passwortmanager."
          }
        }
      }
    },
    "This password was used %@ times in attacks. Do not use it and change it everywhere you use it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Passwort wurde %@-mal bei Angriffen verwendet. Verwende es nicht und ändere es überall, wo du es nutzt."
          }
        }
      }
