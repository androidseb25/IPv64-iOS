    "%@ is asked to pause the check \"%@\". It stays paused until you resume it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird aufgefordert, den Check „%@“ zu pausieren. Er bleibt pausiert, bis du ihn fortsetzt."
          }
