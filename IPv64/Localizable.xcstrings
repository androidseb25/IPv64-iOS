    "Makes this host reachable from the internet via the ipv64 CDN64 servers, over IPv4 and IPv6. The node builds a tunnel outwards; no port needs to be open at home." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macht diesen Host über die ipv64-CDN64-Server per IPv4 und IPv6 aus dem Internet erreichbar. Der Node baut einen Tunnel nach außen auf; zu Hause muss kein Port geöffnet sein."
          }
        }
      }
    },
