      }
    },
    "\"%@\" stops working immediately. Apps and scripts using it lose access." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ funktioniert sofort nicht mehr. Apps und Skripte, die ihn verwenden, verlieren den Zugriff."
          }
        }
      }
    },
    "\"%@\" will be removed from Monitor64. Its history is kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wird aus Monitor64 entfernt. Der Verlauf bleibt erhalten."
          }
        }
      }
    },
