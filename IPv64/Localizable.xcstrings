    "**1.** Go to ipv64.net and log in to your account." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**1.** Öffne ipv64.net und melde dich bei deinem Account an."
          }
        }
      }
    },
    "**2.** Select the **Account** button at the top." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**2.** Tippe oben auf **Account**."
          }
        }
      }
    },
    "**3.** A drop-down menu will open. Select **API**." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**3.** Ein Dropdown-Menü öffnet sich. Wähle **API**."
          }
        }
      }
    },
    "**4.** You will now see a list of API keys (if you have already created more than one). Select the one you want to use by tapping the QR code button." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**4.** Jetzt siehst du eine Liste deiner API-Keys (falls du schon mehrere erstellt hast). Wähle den gewünschten Key, indem du auf die QR-Code-Schaltfläche tippst."
          }
        }
      }
    },
    "**5.** Open the QR code scanner in this app and scan the QR code." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**5.** Öffne den QR-Code-Scanner in dieser App und scanne den QR-Code."
          }
        }
      }
    },
    "**6.** Done! You are now logged in." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**6.** Fertig! Du bist jetzt angemeldet."
          }
        }
      }
    },
